        "authors": ["Sven-83 <276080681+Sven-83@users.noreply.github.com>"],
        "keywords": ["unifi", "network", "topology", "firmware", "access point"],
        "licenseInformation": {
            "type": "free",
            "license": "MIT"
        },
        "platform": "Javascript/Node.js",
        "icon": "unifi-map.png",
        "enabled": true,
        "extIcon": "https://raw.githubusercontent.com/Sven-83/ioBroker.unifi-map/main/admin/unifi-map.png",
        "readme": "https://github.com/Sven-83/ioBroker.unifi-map/blob/main/README.md",
        "loglevel": "info",
        "tier": 2,
        "mode": "daemon",
        "type": "network",
        "compact": true,
        "connectionType": "local",
        "dataSource": "poll",
        "messagebox": true,
        "adminUI": {
            "config": "json",
            "tab": "html"
        },
        "adminTab": {
            "name": {
                "en": "Network",
                "de": "Netzwerk",
                "ru": "Сеть",
                "pt": "Rede",
                "nl": "Netwerk",
                "fr": "Réseau",
                "it": "Rete",
                "es": "Red",
                "pl": "Sieć",
                "uk": "Мережа",
                "zh-cn": "网络"
            },
            "singleton": false
        },
        "dependencies": [
            {
                "js-controller": ">=6.0.11"
            }
        ],
        "globalDependencies": [
            {
                "admin": ">=7.6.20"
            }
        ]
    },
    "native": {
        "host": "",
        "port": 443,
        "apiKey": "",
        "certificate": "",
        "certFingerprint": "",
        "pollInterval": 60,
        "detailInterval": 300,
        "segmentName": ""
    },
    "encryptedNative": ["apiKey"],
    "protectedNative": ["apiKey"],
    "objects": [],
    "instanceObjects": [
        {
            "_id": "info",
            "type": "channel",
            "common": { "name": "Information" },
            "native": {}
        },
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "role": "indicator.connected",
                "name": "Console reachable",
                "type": "boolean",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        },
        {
            "_id": "info.lastUpdate",
            "type": "state",
            "common": {
                "role": "value.time",
                "name": "Time of the last successful poll",
                "type": "number",
                "read": true,
                "write": false,
                "def": 0
            },
            "native": {}
        },
        {
            "_id": "info.dataStale",
            "type": "state",
            "common": {
                "role": "indicator",
                "name": "Data older than 3 intervals",
                "type": "boolean",
                "read": true,
                "write": false,
                "def": true
            },
            "native": {}
        },
        {
            "_id": "info.networkVersion",
            "type": "state",
            "common": {
                "role": "text",
                "name": "Version of the UniFi Network application",
                "type": "string",
                "read": true,
                "write": false,
                "def": ""
            },
            "native": {}
        },
        {
            "_id": "info.restarts",
            "type": "state",
            "common": {
                "role": "json",
                "name": "Start times of the devices (internal)",
                "type": "string",
                "read": true,
                "write": false,
                "def": "{}"
            },
            "native": {}
        },
        {
            "_id": "info.linkSpeeds",
            "type": "state",
            "common": {
                "role": "json",
                "name": "Usual speed of the cable uplinks (internal)",
                "type": "string",
                "read": true,
                "write": false,
                "def": "{}"
            },
            "native": {}
        },
        {
            "_id": "events",
            "type": "channel",
            "common": { "name": "Events" },
            "native": {}
        },
        {
            "_id": "events.last",
            "type": "state",
            "common": {
                "role": "json",
                "name": "Last event (offline, online, restart, degraded, recovered)",
                "type": "string",
                "read": true,
                "write": false,
                "def": ""
            },
            "native": {}
        },
        {
            "_id": "acceptLinkSpeeds",
            "type": "state",
            "common": {
                "role": "button",
                "name": "Accept the current link speeds as usual (e.g. after changing a cable)",
                "type": "boolean",
                "read": false,
                "write": true
            },
            "native": {}
        },
        {
            "_id": "refresh",
            "type": "state",
            "common": {
                "role": "button",
                "name": "Read everything now (at most every 10 s)",
                "type": "boolean",
                "read": false,
                "write": true
            },
            "native": {}
        }
    ]
}
